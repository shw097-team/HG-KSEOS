    {
      "line": 65,
      "text": ""
    },
    {
      "line": 66,
      "text": "def validate_grant(grant: dict, writeset: list[dict], root: Path) -> str | None:"
    },
    {
      "line": 67,
      "text": "    \"\"\"Return a refusal code, or None when the grant is usable for exactly this writeset.\"\"\""
    },
    {
      "line": 68,
      "text": "    if not isinstance(grant, dict):"
    },
    {
      "line": 69,
      "text": "        return \"GRANT_SHAPE\""
    },
    {
      "line": 70,
      "text": "    if grant.get(\"operation\") != \"install_occupant\":"
    },
    {
      "line": 71,
      "text": "        return \"GRANT_OPERATION\""
    },
    {
      "line": 72,
      "text": "    if not grant.get(\"principal\"):"
    },
    {
      "line": 73,
      "text": "        return \"GRANT_PRINCIPAL\""
    },
    {
      "line": 74,
      "text": "    if not grant.get(\"nonce\"):"
    },
    {
      "line": 75,
      "text": "        return \"GRANT_NONCE\""
    },
    {
      "line": 76,
      "text": "    ttl = grant.get(\"expires_at\")"
    },
    {
      "line": 77,
      "text": "    if not isinstance(ttl, (int, float)) or ttl < time.time():"
    },
    {
      "line": 78,
      "text": "        return \"GRANT_EXPIRED\""
    },
    {
      "line": 79,
      "text": "    if not grant.get(\"policy_epoch\"):"
    },
    {
      "line": 80,
      "text": "        return \"GRANT_EPOCH\""
    },
    {
      "line": 81,
      "text": "    # A grant that does not state its assurance level cannot be told apart from a forged one, so the level is"
    },
    {
      "line": 82,
      "text": "    # mandatory and travels into the receipt. CONFORMANCE_ONLY_TEST_SEAM is a real ceiling, not a pass."
    },
    {
      "line": 83,
      "text": "    if grant.get(\"assurance_level\") not in (\"PRODUCTION_ISSUER\", \"CONFORMANCE_ONLY_TEST_SEAM\"):"
    },
    {
      "line": 84,
      "text": "        return \"GRANT_ASSURANCE_UNDECLARED\""
    },
    {
      "line": 85,
      "text": "    refs = grant.get(\"references\")"
    },
    {
      "line": 86,
      "text": "    if not isinstance(refs, list) or len(refs) < 1:"
    },
    {
      "line": 87,
      "text": "        return \"GRANT_UNSIGNED\""
    },
    {
      "line": 88,
      "text": "    declared = {(w.get(\"path\"), w.get(\"preimage\")) for w in grant.get(\"writeset\") or []}"
    },
    {
      "line": 89,
      "text": "    needed = {(w[\"path\"], w[\"preimage\"]) for w in writeset}"
    },
    {
      "line": 90,
      "text": "    if declared != needed:"
    },
    {
      "line": 91,
      "text": "        return \"GRANT_WRITESET_MISMATCH\""
    },
    {
      "line": 92,
      "text": "    for w in writeset:"
    },
    {
      "line": 93,
      "text": "        target = (root / w[\"path\"]).resolve()"
    },
    {
      "line": 94,
      "text": "        if root.resolve() not in target.parents and target != root.resolve():"
    },
    {
      "line": 95,
      "text": "            return \"PATH_TRAVERSAL\""
    },
    {
      "line": 96,
      "text": "        if w[\"preimage\"] != \"ABSENT\" and not target.exists():"
    },
    {
      "line": 97,
      "text": "            return \"PREIMAGE_MISSING\""
    },
    {
      "line": 98,
      "text": "    return None"
    },
