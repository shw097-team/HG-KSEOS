    },
    {
      "line": 40,
      "text": "import sys"
    },
    {
      "line": 41,
      "text": "import time"
    },
    {
      "line": 42,
      "text": "from pathlib import Path"
    },
    {
      "line": 43,
      "text": ""
    },
    {
      "line": 44,
      "text": "LIFECYCLE = [\"PACKAGED\", \"INSTALLED\", \"HOST_LOADED\", \"INVOKED\", \"FUNCTIONALLY_QUALIFIED\"]"
    },
