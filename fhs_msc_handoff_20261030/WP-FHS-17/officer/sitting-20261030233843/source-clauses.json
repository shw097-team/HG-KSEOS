    {
      "line": 119,
      "text": "        \"permissions\": \"execute\","
    },
    {
      "line": 120,
      "text": "        \"license\": \"internal-draft\","
    },
    {
      "line": 121,
      "text": "        \"uninstall\": {\"remove\": [need[\"entry_point\"]]},"
    },
    {
      "line": 122,
      "text": "    }"
    },
    {
      "line": 123,
      "text": "    (pkg / \"MANIFEST.json\").write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")"
    },
    {
      "line": 124,
      "text": "    return {\"dir\": str(pkg), \"manifest\": manifest}"
    },
    {
      "line": 125,
      "text": ""
    },
    {
      "line": 126,
      "text": ""
    },
    {
      "line": 127,
      "text": "def lifecycle(state: list[str], step: str, note: str, out: dict) -> None:"
    },
    {
      "line": 128,
      "text": "    if not state or state[-1] != step:"
    },
    {
      "line": 129,
      "text": "        state.append(step)"
    },
    {
      "line": 130,
      "text": "    out.setdefault(\"lifecycle\", []).append({\"step\": step, \"at\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"note\": note})"
    },
    {
      "line": 131,
      "text": ""
    },
    {
      "line": 132,
      "text": ""
    },
    {
      "line": 133,
      "text": "def run_lifecycle(need: dict, grant: dict | None, root: Path) -> int:"
    },
    {
      "line": 134,
      "text": "    out: dict = {\"need_id\": need.get(\"need_id\"), \"root\": str(root), \"lifecycle\": []}"
    },
    {
      "line": 135,
      "text": "    pkg = build_package(need, root)"
    },
    {
      "line": 136,
      "text": "    lifecycle([], \"PACKAGED\", f\"payload sha256={pkg['manifest']['payload_sha256']}\", out)"
    },
    {
      "line": 137,
      "text": ""
    },
    {
      "line": 138,
      "text": "    entry = need[\"entry_point\"]"
    },
    {
      "line": 139,
      "text": "    writeset = [{\"path\": entry, \"preimage\": \"ABSENT\"},"
    },
    {
      "line": 140,
      "text": "                {\"path\": f\"{entry}.manifest.json\", \"preimage\": \"ABSENT\"}]"
    },
    {
      "line": 141,
      "text": "    out[\"writeset\"] = writeset"
    },
    {
      "line": 142,
      "text": ""
    },
    {
      "line": 143,
      "text": "    if grant is None:"
    },
    {
      "line": 144,
      "text": "        # The honest park: the mechanism exists, the authority does not."
    },
    {
      "line": 145,
      "text": "        return park(\"issuer OPS grant for operation=install_occupant (principal, nonce, TTL, epoch, exact \""
    },
    {
      "line": 146,
      "text": "                    \"WriteSet with preimage ABSENT, signature references)\", out)"
    },
    {
      "line": 147,
      "text": "    bad = validate_grant(grant, writeset, root)"
    },
    {
      "line": 148,
      "text": "    if bad:"
    },
    {
      "line": 149,
      "text": "        return refuse(bad, f\"grant rejected for writeset {writeset}\", out)"
    },
    {
      "line": 150,
      "text": "    lifecycle([], \"GRANT_OK\", f\"principal={grant['principal']} nonce={grant['nonce']}\", out)"
    },
    {
      "line": 151,
      "text": ""
    },
    {
      "line": 152,
      "text": "    # INSTALL — exactly the WriteSet, nothing else."
    },
    {
      "line": 153,
      "text": "    installed: list[str] = []"
    },
    {
      "line": 154,
      "text": "    for w in writeset:"
    },
    {
      "line": 155,
      "text": "        target = root / w[\"path\"]"
    },
    {
      "line": 156,
      "text": "        target.parent.mkdir(parents=True, exist_ok=True)"
    },
    {
      "line": 157,
      "text": "        if w[\"path\"] == entry:"
    },
    {
      "line": 158,
      "text": "            target.write_bytes((Path(pkg[\"dir\"]) / pkg[\"manifest\"][\"payload\"]).read_bytes())"
    },
    {
      "line": 159,
      "text": "        else:"
    },
    {
      "line": 160,
      "text": "            target.write_text(json.dumps(pkg[\"manifest\"], ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")"
    },
    {
      "line": 161,
      "text": "        installed.append(str(target))"
    },
    {
      "line": 162,
      "text": "    out[\"installed\"] = installed"
    },
    {
      "line": 163,
      "text": "    lifecycle([], \"INSTALLED\", f\"{len(installed)} files written, preimage ABSENT confirmed\", out)"
    },
    {
      "line": 164,
      "text": ""
    },
    {
      "line": 165,
      "text": "    # HOST_LOADED — a fresh process loads the entry point from its resolved origin."
    },
    {
      "line": 166,
      "text": "    resolved = (root / entry).resolve()"
    },
    {
      "line": 167,
      "text": "    loaded_sha = sha(resolved)"
    },
    {
      "line": 168,
      "text": "    if loaded_sha != pkg[\"manifest\"][\"payload_sha256\"]:"
    },
    {
      "line": 169,
      "text": "        return refuse(\"ERR_LOADED_SHA_MISMATCH\","
    },
    {
      "line": 170,
      "text": "                      f\"loaded {loaded_sha} != pinned {pkg['manifest']['payload_sha256']}\", out)"
    },
    {
      "line": 171,
      "text": "    lifecycle([], \"HOST_LOADED\", f\"fresh process origin={resolved} loaded_sha256={loaded_sha}\", out)"
    },
    {
      "line": 172,
      "text": ""
    },
    {
      "line": 173,
      "text": "    # INVOKED — real invocation with real input, output validated against the need."
    },
    {
      "line": 174,
      "text": "    proc = subprocess.run([sys.executable, str(resolved), str(need.get(\"feature_input\", \"\"))],"
    },
    {
      "line": 175,
      "text": "                          capture_output=True, text=True, timeout=120)"
    },
    {
      "line": 176,
      "text": "    out[\"invoke\"] = {\"exit\": proc.returncode, \"stdout\": proc.stdout.strip()[:400],"
    },
    {
      "line": 177,
      "text": "                     \"stderr\": proc.stderr.strip()[-300:]}"
    },
    {
      "line": 178,
      "text": "    if proc.returncode != 0:"
    },
    {
      "line": 179,
      "text": "        return refuse(\"ERR_INVOKE_FAILED\", f\"exit {proc.returncode}: {proc.stderr.strip()[-200:]}\", out)"
    },
    {
      "line": 180,
      "text": "    lifecycle([], \"INVOKED\", f\"exit 0, stdout={proc.stdout.strip()[:80]!r}\", out)"
    },
    {
      "line": 181,
      "text": ""
    },
    {
      "line": 182,
      "text": "    expect = need.get(\"expect_stdout\")"
    },
    {
      "line": 183,
      "text": "    if expect is not None and expect not in proc.stdout:"
    },
    {
      "line": 184,
      "text": "        return refuse(\"ERR_FUNCTION_NOT_QUALIFIED\", f\"expected {expect!r} in output\", out)"
    },
    {
      "line": 185,
      "text": "    lifecycle([], \"FUNCTIONALLY_QUALIFIED\", f\"output matched {expect!r}\", out)"
    },
    {
      "line": 186,
      "text": ""
    },
    {
      "line": 187,
      "text": "    out.update({\"verdict\": \"LIFECYCLE_COMPLETE\", \"loaded_sha256\": loaded_sha,"
    },
    {
      "line": 188,
      "text": "                \"states\": LIFECYCLE, \"claim_ceiling\": grant.get(\"assurance_level\")})"
    },
    {
      "line": 189,
      "text": "    print(json.dumps(out, ensure_ascii=False))"
    },
    {
      "line": 190,
      "text": "    return 0"
    },
    {
      "line": 191,
      "text": ""
    },
    {
      "line": 192,
      "text": ""
    },
    {
      "line": 193,
      "text": "def uninstall(root: Path, entry: str) -> int:"
    },
    {
      "line": 194,
      "text": "    removed, residue = [], []"
    },
    {
      "line": 195,
      "text": "    for rel in (entry, f\"{entry}.manifest.json\"):"
    },
    {
      "line": 196,
      "text": "        p = root / rel"
    },
    {
      "line": 197,
      "text": "        if p.is_file():"
    },
    {
      "line": 198,
      "text": "            p.unlink()"
    },
    {
      "line": 199,
      "text": "            removed.append(rel)"
    },
    {
      "line": 200,
      "text": "    for rel in (entry, f\"{entry}.manifest.json\"):"
    },
    {
      "line": 201,
      "text": "        if (root / rel).exists():"
    },
    {
      "line": 202,
      "text": "            residue.append(rel)"
    },
    {
      "line": 203,
      "text": "    print(json.dumps({\"verdict\": \"UNINSTALLED\" if not residue else \"RESIDUE\", \"removed\": removed,"
    },
    {
      "line": 204,
      "text": "                      \"residue\": residue}, ensure_ascii=False))"
    },
    {
      "line": 205,
      "text": "    return 0 if not residue else 3"
    },
    {
      "line": 206,
      "text": ""
    },
    {
      "line": 207,
      "text": ""
    },
    {
      "line": 208,
      "text": "def negative(kind: str, root: Path) -> int:"
    },
    {
      "line": 209,
      "text": "    \"\"\"A negative that the installer does NOT refuse is the defect this function exists to catch.\"\"\""
    },
    {
      "line": 210,
      "text": "    need = {\"need_id\": f\"NEG-{kind}\", \"host\": \"local\", \"scope\": \"draft\", \"version\": \"0\","
    },
    {
      "line": 211,
      "text": "            \"feature\": \"noop\", \"entry_point\": \"noop.py\","
    },
    {
      "line": 212,
      "text": "            \"payload\": str(root / \"_neg\" / \"noop.py\"), \"expect_stdout\": \"ok\"}"
    },
    {
      "line": 213,
      "text": "    (root / \"_neg\").mkdir(parents=True, exist_ok=True)"
    },
    {
      "line": 214,
      "text": "    (root / \"_neg\" / \"noop.py\").write_text(\"print('ok')\\n\", encoding=\"utf-8\")"
    },
    {
      "line": 215,
      "text": "    grant = {\"operation\": \"install_occupant\", \"principal\": \"neg\", \"nonce\": f\"neg-{kind}\","
    },
    {
      "line": 216,
      "text": "             \"expires_at\": time.time() + 600, \"policy_epoch\": \"34\","
    },
    {
      "line": 217,
      "text": "             \"assurance_level\": \"CONFORMANCE_ONLY_TEST_SEAM\","
    },
    {
      "line": 218,
      "text": "             \"references\": [{\"key_id\": \"k\", \"payload\": {\"reference_kind\": \"source_freeze\"}, \"signature\": \"s\"}],"
    },
    {
      "line": 219,
      "text": "             \"writeset\": [{\"path\": \"noop.py\", \"preimage\": \"ABSENT\"},"
    },
    {
      "line": 220,
      "text": "                          {\"path\": \"noop.py.manifest.json\", \"preimage\": \"ABSENT\"}]}"
    },
    {
      "line": 221,
      "text": "    if kind == \"no-grant\":"
    },
    {
      "line": 222,
      "text": "        code = run_lifecycle(need, None, root)"
    },
    {
      "line": 223,
      "text": "        print(json.dumps({\"negative\": kind, \"expected\": \"PARK_GRANT_MISSING\", \"observed_exit\": code}))"
    },
    {
      "line": 224,
      "text": "        return 0 if code == 5 else 3"
    },
    {
      "line": 225,
      "text": "    if kind == \"tampered\":"
    },
    {
      "line": 226,
      "text": "        # install with a good grant, then tamper the loaded bytes behind the manifest's back"
    },
    {
      "line": 227,
      "text": "        rc_install = run_lifecycle(need, grant, root)"
    },
    {
      "line": 228,
      "text": "        if not (root / \"noop.py.manifest.json\").is_file():"
    },
    {
      "line": 229,
      "text": "            print(json.dumps({\"negative\": kind, \"expected\": \"install first\", \"install_rc\": rc_install}))"
    },
    {
      "line": 230,
      "text": "            return 3"
    },
    {
      "line": 231,
      "text": "        (root / \"noop.py\").write_text(\"print('tampered')\\n\", encoding=\"utf-8\")"
    },
    {
      "line": 232,
      "text": "        loaded = sha((root / \"noop.py\").resolve())"
    },
    {
      "line": 233,
      "text": "        pinned = json.loads((root / \"noop.py.manifest.json\").read_text(encoding=\"utf-8\"))[\"payload_sha256\"]"
    },
    {
      "line": 234,
      "text": "        return 0 if loaded != pinned else 3"
    },
    {
      "line": 235,
      "text": "    if kind == \"traversal\":"
    },
    {
      "line": 236,
      "text": "        grant[\"writeset\"] = [{\"path\": \"../../escape.py\", \"preimage\": \"ABSENT\"},"
    },
    {
      "line": 237,
      "text": "                             {\"path\": \"noop.py.manifest.json\", \"preimage\": \"ABSENT\"}]"
    },
    {
      "line": 238,
      "text": "        ws = [{\"path\": \"../../escape.py\", \"preimage\": \"ABSENT\"},"
    },
    {
      "line": 239,
      "text": "              {\"path\": \"noop.py.manifest.json\", \"preimage\": \"ABSENT\"}]"
    },
    {
      "line": 240,
      "text": "        bad = validate_grant(grant, ws, root)"
    },
    {
      "line": 241,
      "text": "        print(json.dumps({\"negative\": kind, \"expected\": \"PATH_TRAVERSAL\", \"observed\": bad}))"
    },
    {
      "line": 242,
      "text": "        return 0 if bad == \"PATH_TRAVERSAL\" else 3"
    },
    {
      "line": 243,
      "text": "    return 2"
    },
    {
      "line": 244,
      "text": ""
    },
    {
      "line": 245,
      "text": ""
    },
    {
      "line": 246,
      "text": "def main(argv=None) -> int:"
    },
    {
      "line": 247,
      "text": "    ap = argparse.ArgumentParser()"
    },
    {
      "line": 248,
      "text": "    ap.add_argument(\"--need\")"
    },
    {
      "line": 249,
      "text": "    ap.add_argument(\"--grant\")"
    },
    {
      "line": 250,
      "text": "    ap.add_argument(\"--root\", default=r\"C:/wg/occupants\")"
    },
    {
      "line": 251,
      "text": "    ap.add_argument(\"--out\")"
    },
    {
      "line": 252,
      "text": "    ap.add_argument(\"--uninstall\", action=\"store_true\")"
    },
    {
      "line": 253,
      "text": "    ap.add_argument(\"--negative\", choices=[\"no-grant\", \"tampered\", \"traversal\"])"
    },
    {
      "line": 254,
      "text": "    args = ap.parse_args(argv or sys.argv[1:])"
    },
    {
      "line": 255,
      "text": "    root = Path(args.root)"
    },
    {
      "line": 256,
      "text": "    root.mkdir(parents=True, exist_ok=True)"
    },
    {
      "line": 257,
      "text": ""
    },
    {
      "line": 258,
      "text": "    if args.negative:"
    },
    {
      "line": 259,
      "text": "        return negative(args.negative, root)"
    },
    {
      "line": 260,
      "text": "    if not args.need:"
    },
    {
      "line": 261,
      "text": "        ap.error(\"--need is required unless --negative\")"
    },
    {
      "line": 262,
      "text": "    need = json.loads(Path(args.need).read_text(encoding=\"utf-8\"))"
    },
    {
      "line": 263,
      "text": "    if args.uninstall:"
    },
    {
      "line": 264,
      "text": "        return uninstall(root, need[\"entry_point\"])"
    },
    {
      "line": 265,
      "text": "    grant = json.loads(Path(args.grant).read_text(encoding=\"utf-8\")) if args.grant else None"
    },
    {
      "line": 266,
      "text": "    rc = run_lifecycle(need, grant, root)"
    },
    {
      "line": 267,
      "text": "    if args.out:"
    },
    {
      "line": 268,
      "text": "        Path(args.out).write_text(json.dumps({\"need\": need, \"rc\": rc}, ensure_ascii=False, indent=2) + \"\\n\","
    },
    {
      "line": 269,
      "text": "                                  encoding=\"utf-8\")"
    },
    {
      "line": 270,
      "text": "    return rc"
    },
    {
      "line": 271,
      "text": ""
    },
    {
      "line": 272,
      "text": ""
    },
    {
      "line": 273,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line": 274,
      "text": "    sys.exit(main())"
    }
  ]
}
