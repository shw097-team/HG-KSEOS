    {
      "line": 50,
      "text": ""
    },
    {
      "line": 51,
      "text": "def refuse(code: str, detail: str, out: dict | None, exit_code: int = 3) -> int:"
    },
    {
      "line": 52,
      "text": "    payload = dict(out or {})"
    },
    {
      "line": 53,
