    {
      "line": 57,
      "text": ""
    },
    {
      "line": 58,
      "text": "def park(missing: str, out: dict) -> int:"
    },
    {
      "line": 59,
      "text": "    payload = dict(out)"
    },
    {
      "line": 60,
      "text": "    payload.update({\"verdict\": \"PARK_GRANT_MISSING\", \"missing_object\": missing,"
    },
    {
